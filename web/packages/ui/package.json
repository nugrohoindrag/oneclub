{
  "name": "@oneclub/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Morphic Design System (OneClub packages/ui) — Material 3-based, tokens + components + patterns.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens/*": "./src/tokens/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build --config vite.showcase.config.ts",
    "showcase": "vite --config vite.showcase.config.ts",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
