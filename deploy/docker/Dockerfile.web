# OneClub frontend images.
#   target "static": Back Office, Member Portal, Ops, Platform Admin SPAs/PWAs
#                    built once and served by Caddy (no runtime config needed:
#                    branding/flags are fetched from /api/v1/public/bootstrap,
#                    FR-BRD-02).
#   target "web":    public website (Next.js, SSR).
#
# VPS releases set SOURCEMAPS=false so no source maps ship (Technical Doc §9.4).

FROM node:24-alpine AS deps
WORKDIR /web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/apps/web/package.json apps/web/
COPY web/apps/backoffice/package.json apps/backoffice/
COPY web/apps/member/package.json apps/member/
COPY web/apps/ops/package.json apps/ops/
COPY web/apps/platform-admin/package.json apps/platform-admin/
COPY web/packages/ui/package.json packages/ui/
COPY web/packages/api-client/package.json packages/api-client/
COPY web/packages/i18n/package.json packages/i18n/
COPY web/packages/offline/package.json packages/offline/
COPY web/packages/shell/package.json packages/shell/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG SOURCEMAPS=false
ENV SOURCEMAPS=${SOURCEMAPS} NEXT_TELEMETRY_DISABLED=1
COPY web/ ./
RUN pnpm -r --filter "./apps/*" build

FROM busybox:1.37 AS static
COPY --from=build /web/apps/backoffice/dist /srv/backoffice
COPY --from=build /web/apps/member/dist /srv/member
COPY --from=build /web/apps/ops/dist /srv/ops
COPY --from=build /web/apps/platform-admin/dist /srv/platform-admin
CMD ["sh", "-c", "cp -r /srv/. /export/ && echo copied"]

FROM node:24-alpine AS web
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
COPY --from=build /web/apps/web/.next/standalone ./
COPY --from=build /web/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /web/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
