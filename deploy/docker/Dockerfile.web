# OneClub frontend images.
#   target "static": Staff App and Member Portal SPAs/PWAs
#                    built once and served by Caddy (no runtime config needed:
#                    branding/flags are fetched from /api/v1/public/bootstrap,
#                    FR-BRD-02).
#   target "web":    public website (Next.js, SSR).
#
# VPS releases (branch production) build with OBFUSCATE=true: no source maps
# and the JavaScript of every app obfuscated, browser and server side
# (web/scripts/obfuscate.mjs, Technical Doc §9.4).

FROM node:24-alpine AS deps
WORKDIR /web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/apps/web/package.json apps/web/
COPY web/apps/staff/package.json apps/staff/
COPY web/apps/member/package.json apps/member/
COPY web/packages/ui/package.json packages/ui/
COPY web/packages/api-client/package.json packages/api-client/
COPY web/packages/i18n/package.json packages/i18n/
COPY web/packages/offline/package.json packages/offline/
COPY web/packages/shell/package.json packages/shell/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG SOURCEMAPS=false
ARG OBFUSCATE=false
ARG OBFUSCATE_SEED=0
ENV SOURCEMAPS=${SOURCEMAPS} NEXT_TELEMETRY_DISABLED=1
COPY web/ ./
RUN pnpm -r --filter "./apps/*" build
RUN if [ "$OBFUSCATE" = "true" ]; then \
      [ "$SOURCEMAPS" = "false" ] || { echo "OBFUSCATE=true needs SOURCEMAPS=false"; exit 1; }; \
      export OBFUSCATE_SEED; \
      node scripts/obfuscate.mjs browser apps/staff/dist apps/member/dist apps/web/.next/static && \
      node scripts/obfuscate.mjs node apps/web/.next/standalone/apps/web/.next/server && \
      find apps/staff/dist apps/member/dist apps/web/.next/static apps/web/.next/standalone/apps -name '*.map' -delete; \
    fi

FROM busybox:1.37 AS static
COPY --from=build /web/apps/staff/dist /srv/staff
COPY --from=build /web/apps/member/dist /srv/member
CMD ["sh", "-c", "cp -r /srv/. /export/ && echo copied"]

FROM node:24-alpine AS web
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
COPY --from=build --chown=node:node /web/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /web/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /web/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
