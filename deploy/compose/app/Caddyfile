# Caddy: TLS, security headers, static shells and load balancing to the API
# replicas (Technical Doc §3.1, §9.3, §10.3).
{
	email {$ACME_EMAIL}
	# Custom domains (FR-INS-06): certificates are issued on demand only for
	# hostnames the API reports as verified and active.
	on_demand_tls {
		ask http://api:8080/api/v1/public/domains/allowed
	}
}

(api) {
	handle /api/* {
		reverse_proxy {
			# Docker DNS returns every api replica; re-resolved every second
			# so rolling updates add/remove replicas without a reload.
			dynamic a api 8080 {
				refresh 1s
			}
			lb_policy round_robin
			lb_try_duration 10s
			lb_try_interval 250ms
			health_uri /readyz
			health_interval 2s
			health_timeout 2s
			fail_duration 5s
		}
	}
}

# Argument: the geolocation allowlist, "(self)" only where the caddy tablet
# measures GPS distances (FR-CTB-11) and on the Attendance Form (mobile GPS
# clock-in, FR-ATT-01), "()" elsewhere.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation={args[0]}, microphone=()"
		# Icons are self-hosted (decision 4g, font-src 'self'); fonts.googleapis.com and
		# fonts.gstatic.com serve only the text fonts (Inter, Roboto Flex), which fall
		# back to system fonts when unreachable.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}
}

(spa) {
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# Staff App: one build served on five domains (Technical Doc §6.1).
# Argument: the surface (dashboard, cashier, caddy, kitchen, presence). The app reads
# its surface and the instance's other Staff App domains from /surface.json;
# the manifest names the installed app after the surface.
(staff-app) {
	handle /surface.json {
		header Content-Type application/json
		header Cache-Control no-cache
		respond `{"surface":"{args[0]}","domains":{"dashboard":"https://{$DOMAIN_DASHBOARD}","cashier":"https://{$DOMAIN_CASHIER}","caddy":"https://{$DOMAIN_CADDY}","kitchen":"https://{$DOMAIN_KITCHEN}","presence":"https://{$DOMAIN_PRESENCE}"}}` 200
	}
	handle {
		root * /srv/staff
		rewrite /manifest.webmanifest /manifest-{args[0]}.webmanifest
		header /sw.js Cache-Control "no-cache"
		import spa
	}
}

# Back Office, Management Dashboard, Platform Administration, Clubhouse
# Screen; the host of PUBLIC_BASE_URL (links in e-mails).
{$DOMAIN_DASHBOARD} {
	import security ()
	import api
	handle {
		import staff-app dashboard
	}
}

# Operational Interface (POS, front desk, starter, …) on shared devices.
{$DOMAIN_CASHIER} {
	import security ()
	import api
	handle {
		import staff-app cashier
	}
}

{$DOMAIN_CADDY} {
	import security (self)
	import api
	handle {
		import staff-app caddy
	}
}

{$DOMAIN_KITCHEN} {
	import security ()
	import api
	handle {
		import staff-app kitchen
	}
}

# Attendance Form: clock in / out with employee ID, attendance PIN and GPS,
# without signing in (every path is the form).
{$DOMAIN_PRESENCE} {
	import security (self)
	import api
	handle {
		import staff-app presence
	}
}

{$DOMAIN_MEMBER} {
	import security ()
	import api
	handle {
		root * /srv/member
		import spa
	}
}

{$DOMAIN_WEB} {
	import security ()
	import api
	handle {
		reverse_proxy web:3000
	}
}

# Verified custom domains of this instance (any surface) are served here.
# The API decides which hostnames are allowed and answers which application
# they serve (X-Surface); a Staff App surface gets its own /surface.json.
https:// {
	tls {
		on_demand
	}
	import security (self)
	import api
	handle {
		forward_auth api:8080 {
			uri /api/v1/public/domains/allowed?domain={host}
			copy_headers X-Surface
		}
		@staff header_regexp X-Surface ^(dashboard|cashier|caddy|kitchen|presence)$
		handle @staff {
			import staff-app {http.request.header.X-Surface}
		}
		@member header X-Surface member
		handle @member {
			root * /srv/member
			import spa
		}
		handle {
			reverse_proxy web:3000
		}
	}
}
